aws_region = "us-west-2"
environment = "dev"

# Select this profile deliberately. Do not put a Databricks token here.
databricks_profile = "tidetrack-private"

# Copy these two outputs from ../aws after it is applied.
private_bucket_name = "REPLACE-WITH-AWS-OUTPUT"
data_kms_key_arn    = "REPLACE-WITH-AWS-OUTPUT"

source_prefix      = "raw"
catalog_name       = "tidetrack_private"
data_classification = "health-sensitive"

# For a personal plan/apply trial these may remain null. Before shared or
# production use, prefer an account group owner and service-principal IDs.
catalog_owner     = null
pipeline_principal = null
app_principal      = null
