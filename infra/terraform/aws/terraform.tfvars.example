aws_region  = "us-west-2"
environment = "dev"

# Null values produce globally unique names with a random suffix.
private_bucket_name = null
demo_bucket_name    = null

noncurrent_version_retention_days = 45

# Safe trial defaults. Revisit before private data is uploaded.
enable_cloudtrail                  = false
enable_account_public_access_block = false
create_tidepool_secret             = false
create_collector_role              = false

# When create_collector_role is true, use stable IAM role ARNs, not
# arn:aws:sts::*:assumed-role/... session ARNs.
collector_trusted_principal_arns = []

tags = {
  Owner      = "replace-me"
  CostCenter = "personal-research"
}
